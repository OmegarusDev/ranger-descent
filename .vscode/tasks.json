{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Ranger Descent",
      "type": "shell",
      "command": "python3 scripts/serve.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ranger-descent-serve",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving Ranger Descent at|Already serving Ranger Descent at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
